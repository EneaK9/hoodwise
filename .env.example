# Postgres — local socket (Homebrew) or docker-compose
# DATABASE_URL=postgresql://hoodwise:hoodwise@localhost:5432/hoodwise
DATABASE_URL=postgresql:///hoodwise

# Auth
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=720

# LLM / embeddings — leave blank to run extract-only locally
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Drafts answers with web search on (needs web_search_20260209 support: Opus 5 / 4.8 / 4.7 / 4.6, Sonnet 5 / 4.6)
CHAT_MODEL=claude-opus-5
VISION_MODEL=claude-sonnet-4-5
# Reads each question (part, car, engine, what to ask back) with structured output; falls back to CHAT_MODEL
UNDERSTAND_MODEL=claude-opus-5
# Checks every figure in the draft against the manual pages and web passages
VERIFY_MODEL=claude-opus-5

# Paths
MANUAL_DIR=FC&FK Service Manual
DATA_DIR=data
IMAGE_DIR=data/images

# App
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_VIN_PER_MIN=30
# Shop search links: eu (ebay.de / amazon.de / autodoc.de, ship to the Balkans), uk, or us
SHOP_REGION=eu

# Optional global VIN decode (needed for non-US cars; NHTSA is free but US-certified only)
# VINCARIO_API_KEY=
# VINCARIO_SECRET_KEY=
# CARSXE_API_KEY=
# API_NINJAS_KEY=
